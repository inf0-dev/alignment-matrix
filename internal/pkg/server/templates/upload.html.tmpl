<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>alma</title>
  <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="shortcut icon" href="/assets/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plaster&display=swap">
  <style>
    :root {
      --bg: #fafafa;
      --surface: #ffffff;
      --border: #e8e8e8;
      --text: #1a1a1a;
      --text-secondary: #555555;
      --accent: #009ACA;
      --accent-soft: #e6f6fc;
      --radius: 10px;
      --shadow-md: 0 2px 8px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    }

    [data-theme="dark"] {
      --bg: #0f0f0f;
      --surface: #1a1a1a;
      --border: #2a2a2a;
      --text: #e5e5e5;
      --text-secondary: #a0a0a0;
      --accent: #33b5e0;
      --accent-soft: #0d2a38;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0f0f0f;
        --surface: #1a1a1a;
        --border: #2a2a2a;
        --text: #e5e5e5;
        --text-secondary: #a0a0a0;
        --accent: #33b5e0;
        --accent-soft: #0d2a38;
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { font-size: 110%; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .upload-container {
      max-width: 520px;
      width: 100%;
      text-align: center;
    }

    h1 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .alma-logo {
      font-family: 'Plaster', sans-serif;
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      user-select: none;
    }
    .alma-logo > span {
      display: inline-block;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .alma-logo > span:hover {
      transform: scale(1.1);
    }
    .alma-a1 { color: #009aca; }
    .alma-l  { color: #00da3f; }
    .alma-m  { color: #ff9c00; }
    .alma-a2 { color: #ff007b; }

    .subtitle {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 2rem;
    }

    .drop-zone {
      border: 2px dashed var(--border);
      border-radius: var(--radius);
      padding: 3rem 2rem;
      background: var(--surface);
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
    }

    .drop-zone:hover,
    .drop-zone.drag-over {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .drop-zone-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      opacity: 0.6;
    }

    .drop-zone-text {
      font-size: 0.95rem;
      color: var(--text-secondary);
      margin-bottom: 0.5rem;
    }

    .drop-zone-hint {
      font-size: 0.8rem;
      color: var(--text-secondary);
      opacity: 0.7;
    }

    .file-input {
      display: none;
    }

    .browse-link {
      color: var(--accent);
      text-decoration: underline;
      cursor: pointer;
    }

    .error-msg {
      margin-top: 1rem;
      color: #dc2626;
      font-size: 0.85rem;
      display: none;
    }

    .error-msg.visible {
      display: block;
    }

    .page-footer {
      margin-top: 2rem;
      padding-top: 1rem;
      font-size: 0.75rem;
      color: var(--text-secondary);
      text-align: center;
    }

    .page-footer a {
      color: var(--accent);
      text-decoration: none;
    }

    .page-footer a:hover {
      text-decoration: underline;
    }
    .page-footer .alma-link:hover {
      background: linear-gradient(90deg, #009aca, #00da3f, #ff9c00, #ff007b, #009aca);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
      animation: alma-gradient 2s linear infinite;
    }
    @keyframes alma-gradient {
      to { background-position: -200% 0; }
    }
  </style>
</head>
<body>
  <div class="upload-container">
    <h1 class="alma-logo"><span class="alma-a1">a</span><span class="alma-l">l</span><span class="alma-m">m</span><span class="alma-a2">a</span></h1>
    <p class="subtitle">Upload a document or record to get started</p>

    <div class="drop-zone" id="drop-zone">
      <div class="drop-zone-icon">📄</div>
      <div class="drop-zone-text">
        Drag & drop your file here, or <span class="browse-link" id="browse-link">browse</span>
      </div>
      <div class="drop-zone-hint">.yaml, .yml, or .json</div>
    </div>

    <input type="file" class="file-input" id="file-input" accept=".yaml,.yml,.json">

    <div class="error-msg" id="error-msg"></div>
  </div>

  <footer class="page-footer">
    Built with <a class="alma-link" href="https://github.com/inf0-dev/alma" target="_blank" rel="noopener">alma</a> by <a href="https://github.com/inf0-dev" target="_blank" rel="noopener">inf0-dev</a>
  </footer>

  <script>
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const browseLink = document.getElementById('browse-link');
    const errorMsg = document.getElementById('error-msg');

    function showError(msg) {
      errorMsg.textContent = msg;
      errorMsg.classList.add('visible');
    }

    function clearError() {
      errorMsg.classList.remove('visible');
    }

    async function uploadFile(file) {
      clearError();
      const form = new FormData();
      form.append('file', file);

      try {
        const resp = await fetch('/upload', { method: 'POST', body: form });
        if (resp.ok) {
          window.location.href = '/';
        } else {
          const text = await resp.text();
          showError(text || 'Upload failed');
        }
      } catch (e) {
        showError('Upload failed: ' + e.message);
      }
    }

    browseLink.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('click', (e) => {
      if (e.target !== browseLink) fileInput.click();
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) uploadFile(fileInput.files[0]);
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('drag-over');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      if (e.dataTransfer.files.length > 0) uploadFile(e.dataTransfer.files[0]);
    });
  </script>
</body>
</html>
