  </footer>

  <script id="data-requirements" type="application/json">[{"id":"req-latency","is_hard":true,"checked":true},{"id":"req-budget","is_hard":true,"checked":true},{"id":"req-ha","is_hard":true,"checked":true},{"id":"req-observability","is_hard":false,"checked":true},{"id":"req-team-skill","is_hard":false,"checked":false}]</script>
  <script id="data-items" type="application/json">[{"id":"q-traffic","kind":"choice"},{"id":"q-region","kind":"choice"},{"id":"q-data-sensitivity","kind":"choice"},{"id":"q-ttl","kind":"number","unit":"seconds"},{"id":"q-notes","kind":"text"}]</script>
  <script id="data-schema" type="application/json">{"title":"Cache Strategy Decision","issue":"https://github.com/example/project/issues/42","categories":["performance","cost","operations"],"requirements":[{"id":"req-latency","description":"P99 latency under 50ms","is_hard":true},{"id":"req-budget","description":"Stay within $500/mo infrastructure budget","is_hard":true},{"id":"req-ha","description":"99.9% availability SLA","is_hard":true},{"id":"req-observability","description":"Supports distributed tracing","is_hard":false},{"id":"req-team-skill","description":"Team has operational experience","is_hard":false}],"items":[{"id":"q-traffic","description":"Expected peak traffic","kind":"choice","choice_options":[{"id":"low","description":"Under 1k RPS"},{"id":"mid","description":"1k–10k RPS"},{"id":"high","description":"Over 10k RPS"}]},{"id":"q-region","description":"Multi-region deployment","kind":"choice","choice_options":[{"id":"yes","description":"Yes, multi-region"},{"id":"no","description":"Single region"}]},{"id":"q-data-sensitivity","description":"Data sensitivity level","kind":"choice","choice_options":[{"id":"public","description":"Public data"},{"id":"internal","description":"Internal only"},{"id":"pii","description":"Contains PII"}],"note":"Affects where data can be cached and for how long"},{"id":"q-ttl","description":"Cache TTL","kind":"number","number_config":{"unit":"seconds","min":1,"max":3600}},{"id":"q-notes","description":"Additional context or constraints","kind":"text"}],"design_options":[{"id":"opt-redis","title":"Redis Cluster","description":"Managed Redis with read replicas and automatic failover","requirements_met":{"req-budget":{"met":false,"partial":true,"reason":"Costs scale with cluster size, may exceed at high traffic"},"req-ha":{"met":true},"req-latency":{"met":true},"req-observability":{"met":true},"req-team-skill":{"met":true}},"effects":{"q-data-sensitivity.pii":[{"kind":"changes","category":"operations","text":"Requires encryption at rest and audit logging"}],"q-region.yes":[{"kind":"changes","category":"cost","text":"Cross-region replication doubles infrastructure cost"},{"kind":"changes","category":"performance","text":"Replication lag adds 10-30ms to cross-region reads"}],"q-traffic.high":[{"kind":"changes","category":"cost","text":"Requires 3+ read replicas, pushing costs to ~$800/mo"},{"kind":"note","category":"performance","text":"Connection pooling strongly recommended"}],"q-traffic.mid":[{"kind":"note","category":"cost","text":"Single replica sufficient, stays within budget"}]},"blocks":[{"condition":["q-traffic.high","q-region.yes"],"reason":"Redis cross-region replication cannot meet latency SLA at high traffic volumes"}],"pros":["Battle-tested, rich data structures","Strong community and tooling","Built-in pub/sub for cache invalidation"],"cons":["Operational overhead for cluster management","Memory-bound, expensive at scale"]},{"id":"opt-cdn","title":"CDN Edge Cache","description":"Cache at the edge using a CDN provider like CloudFront or Fastly","requirements_met":{"req-budget":{"met":true},"req-ha":{"met":true},"req-latency":{"met":true},"req-observability":{"met":false},"req-team-skill":{"met":false}},"effects":{"q-data-sensitivity.internal":[{"kind":"changes","category":"operations","text":"Requires signed URLs and origin authentication"}],"q-data-sensitivity.pii":[{"kind":"changes","category":"operations","text":"PII must not be cached at edge — breaks CDN caching model"}],"q-region.yes":[{"kind":"note","category":"performance","text":"Edge nodes are inherently multi-region"}],"q-traffic.high":[{"kind":"note","category":"performance","text":"CDN handles scale natively, no config changes needed"}]},"blocks":[{"condition":["q-data-sensitivity.pii"],"reason":"CDN edge caching is incompatible with PII data handling requirements"}],"pros":["Zero operational overhead","Globally distributed by default","Cost-effective at any scale"],"cons":["Limited invalidation control (TTL-based)","No tracing or observability built in","Team has no CDN operational experience"]},{"id":"opt-memcached","title":"Memcached","description":"Simple in-memory key-value store, optimized for high-throughput reads","requirements_met":{"req-budget":{"met":true},"req-ha":{"met":false},"req-latency":{"met":true},"req-observability":{"met":false},"req-team-skill":{"met":true}},"effects":{"q-region.yes":[{"kind":"changes","category":"operations","text":"No built-in replication — must run independent clusters per region"}],"q-traffic.high":[{"kind":"note","category":"performance","text":"Excellent throughput, but no persistence if a node fails"}]},"pros":["Extremely fast, simple protocol","Low memory overhead per key","Team already runs Memcached in production"],"cons":["No persistence or replication","No complex data structures","Single point of failure without custom HA wrapper"]},{"id":"opt-app-cache","title":"Application-Level Cache","description":"In-process cache using an LRU library (e.g., Ristretto, BigCache)","requirements_met":{"req-budget":{"met":true},"req-ha":{"met":false,"partial":true,"reason":"Availability tied to application instances — no shared state"},"req-latency":{"met":true},"req-observability":{"met":true},"req-team-skill":{"met":true}},"effects":{"q-data-sensitivity.pii":[{"kind":"note","category":"operations","text":"Data stays in-process, simplifies compliance"}],"q-region.yes":[{"kind":"note","category":"operations","text":"No cross-region concerns — each instance is independent"}],"q-traffic.high":[{"kind":"changes","category":"performance","text":"Each instance maintains its own cache — cold starts after deploys"},{"kind":"note","category":"cost","text":"Increases application memory footprint significantly"}]},"blocks":[{"condition":["q-traffic.high","q-region.yes"],"reason":"Per-instance caches cause severe cache fragmentation across regions at high traffic"}],"pros":["Zero infrastructure cost","Sub-microsecond latency","No network calls"],"cons":["Not shared across instances","Cache lost on deploy/restart","Memory pressure on application pods"]}]}</script>
  <script>// Theme toggle
(function () {
  var stored = localStorage.getItem("am-theme");
  var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  if (stored === "dark" || (!stored && prefersDark)) {
    document.documentElement.setAttribute("data-theme", "dark");
  }
})();

document.addEventListener("DOMContentLoaded", function () {
  // Theme toggle button
  document.getElementById("theme-toggle").addEventListener("click", function () {
    var isDark = document.documentElement.getAttribute("data-theme") === "dark";
    if (isDark) {
      document.documentElement.removeAttribute("data-theme");
      localStorage.setItem("am-theme", "light");
    } else {
      document.documentElement.setAttribute("data-theme", "dark");
      localStorage.setItem("am-theme", "dark");
    }
  });

  var state = {
    requirements: JSON.parse(document.getElementById("data-requirements").textContent),
    items: JSON.parse(document.getElementById("data-items").textContent),
    schema: JSON.parse(document.getElementById("data-schema").textContent),
  };

  // Bind requirement buttons (click to toggle)
  document.querySelectorAll(".req").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var id = this.dataset.id;
      for (var i = 0; i < state.requirements.length; i++) {
        if (state.requirements[i].id === id) {
          state.requirements[i].checked = !state.requirements[i].checked;
          this.classList.toggle("active", state.requirements[i].checked);
          break;
        }
      }
      evaluate();
    });
  });

  // Bind choice buttons
  document.querySelectorAll(".choice").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var itemId = this.dataset.item;
      var answerId = this.dataset.answer;

      for (var i = 0; i < state.items.length; i++) {
        if (state.items[i].id === itemId) {
          if (state.items[i].answer === answerId) {
            state.items[i].answer = null;
          } else {
            state.items[i].answer = answerId;
          }
          break;
        }
      }

      document.querySelectorAll('.choice[data-item="' + itemId + '"]').forEach(function (b) {
        b.classList.toggle("selected", b.dataset.answer === (state.items.find(function (it) { return it.id === itemId; }) || {}).answer);
      });

      evaluate();
    });
  });

  // Bind number/text inputs
  document.querySelectorAll(".item-input").forEach(function (input) {
    input.addEventListener("input", function () {
      var itemId = this.dataset.item;
      for (var i = 0; i < state.items.length; i++) {
        if (state.items[i].id === itemId) {
          if (this.type === "number") {
            state.items[i].value = this.value === "" ? null : Number(this.value);
          } else {
            state.items[i].value = this.value || null;
          }
          break;
        }
      }
    });
  });

  function evaluate() {
    var checkedReqs = {};
    state.requirements.forEach(function (r) { checkedReqs[r.id] = r.checked; });

    var hardReqs = {};
    state.schema.requirements.forEach(function (r) { hardReqs[r.id] = r.is_hard; });

    var activeKeys = {};
    state.items.forEach(function (item) {
      if (item.kind === "choice" && item.answer) {
        activeKeys[item.id + "." + item.answer] = true;
      }
    });

    state.schema.design_options.forEach(function (opt) {
      var hardMet = 0, hardOf = 0, softMet = 0, softOf = 0;
      var failedReqs = [];

      var reqsMet = opt.requirements_met || {};
      Object.keys(reqsMet).forEach(function (reqId) {
        var status = reqsMet[reqId];
        var isHard = hardReqs[reqId];
        var checked = checkedReqs[reqId];

        if (isHard) {
          hardOf++;
          if (status.met || status.partial) { hardMet++; }
          else if (checked) { failedReqs.push(reqId); }
        } else {
          softOf++;
          if (status.met || status.partial) { softMet++; }
        }
      });

      // Check blocks
      var firedBlocks = [];
      (opt.blocks || []).forEach(function (block) {
        var allMatch = block.condition.every(function (key) { return activeKeys[key]; });
        if (allMatch) { firedBlocks.push(block.reason); }
      });

      // Collect effects
      var effects = [];
      Object.keys(opt.effects || {}).forEach(function (key) {
        if (!activeKeys[key]) return;
        var parts = key.split(".");
        (opt.effects[key] || []).forEach(function (eff) {
          effects.push({
            item: parts[0], answer: parts[1],
            kind: eff.kind, category: eff.category || "", text: eff.text,
          });
        });
      });

      // Determine status
      var status;
      if (failedReqs.length > 0) { status = "eliminated"; }
      else if (firedBlocks.length > 0) { status = "blocked"; }
      else { status = "possible"; }

      // Update DOM
      var el = document.getElementById("option-" + opt.id);
      if (!el) return;

      el.className = "option " + status;

      var statusEl = el.querySelector(".option-status");
      statusEl.textContent = status;
      statusEl.className = "option-status " + status;

      // Requirement grid
      var gridEl = el.querySelector(".req-grid");
      if (gridEl) {
        var cells = gridEl.querySelectorAll(".req-cell");
        cells.forEach(function (cell) {
          var reqId = cell.dataset.req;
          var reqStatus = reqsMet[reqId];
          var isHard = hardReqs[reqId];
          var checked = checkedReqs[reqId];
          cell.className = "req-cell";
          if (reqStatus) {
            if (reqStatus.met) {
              cell.classList.add("met");
            } else if (reqStatus.partial) {
              cell.classList.add("partial");
            } else if (checked && isHard) {
              cell.classList.add("failed");
            }
          }
        });
        var label = gridEl.querySelector(".req-grid-label");
        label.textContent = hardMet + "/" + hardOf + " hard · " + softMet + "/" + softOf + " soft";
      }

      // Failed requirements
      var failedEl = el.querySelector(".failed-reqs");
      if (failedReqs.length > 0) {
        var descs = failedReqs.map(function (id) {
          var r = state.schema.requirements.find(function (req) { return req.id === id; });
          return r ? r.description : id;
        });
        failedEl.textContent = "Failed: " + descs.join(", ");
        failedEl.style.display = "";
      } else {
        failedEl.style.display = "none";
      }

      // Fired blocks
      var blocksEl = el.querySelector(".blocks-list");
      if (firedBlocks.length > 0) {
        blocksEl.innerHTML = firedBlocks.map(function (r) {
          return '<li class="block-reason">' + escapeHtml(r) + "</li>";
        }).join("");
        blocksEl.style.display = "";
      } else {
        blocksEl.style.display = "none";
      }

      // Effects
      var effectsEl = el.querySelector(".effects-list");
      if (effects.length > 0) {
        effectsEl.innerHTML = effects.map(function (e) {
          var cat = e.category ? '<span class="effect-category">' + escapeHtml(e.category) + "</span> " : "";
          return "<li>" + cat + escapeHtml(e.text) + ' <span style="color:var(--text-tertiary)">(' + escapeHtml(e.kind) + ")</span></li>";
        }).join("");
        effectsEl.style.display = "";
      } else {
        effectsEl.style.display = "none";
      }
    });
  }

  function escapeHtml(s) {
    var div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  // Initial evaluation
  evaluate();
});
</script>
</body>
</html>
