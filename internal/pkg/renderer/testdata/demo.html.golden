<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cache Strategy Decision</title>
  <style>:root {
  --bg: #fafafa;
  --surface: #ffffff;
  --surface-hover: #f5f5f5;
  --border: #e8e8e8;
  --border-strong: #d4d4d4;
  --text: #1a1a1a;
  --text-secondary: #555555;
  --text-tertiary: #888888;
  --accent: #2563eb;
  --accent-soft: #eff4ff;
  --success: #16a34a;
  --success-bg: #f0fdf4;
  --success-border: #bbf7d0;
  --blocked: #d63030;
  --blocked-bg: #fef0f0;
  --blocked-border: #fdc8c8;
  --danger: #dc2626;
  --danger-bg: #fef2f2;
  --danger-border: #fecaca;
  --grid-empty: #e0e0e0;
  --grid-met: #16a34a;
  --grid-partial: #86efac;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 2px 8px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-lg: 0 4px 16px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.04);
  --radius: 10px;
  --radius-sm: 6px;
  --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --mono: "SF Mono", "Fira Code", "Fira Mono", Menlo, monospace;
}

[data-theme="dark"] {
    --bg: #0f0f0f;
    --surface: #1a1a1a;
    --surface-hover: #222222;
    --border: #2a2a2a;
    --border-strong: #3a3a3a;
    --text: #e5e5e5;
    --text-secondary: #a0a0a0;
    --text-tertiary: #707070;
    --accent: #4d8bf5;
    --accent-soft: #1a2744;
    --success: #22c55e;
    --success-bg: #0c2618;
    --success-border: #166534;
    --blocked: #f04848;
    --blocked-bg: #2a1212;
    --blocked-border: #7f1d1d;
    --danger: #ef4444;
    --danger-bg: #2a1010;
    --danger-border: #7f1d1d;
    --grid-empty: #333333;
    --grid-met: #22c55e;
    --grid-partial: #4ade80;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.2);
    --shadow-md: 0 2px 8px rgba(0,0,0,0.3), 0 1px 2px rgba(0,0,0,0.2);
    --shadow-lg: 0 4px 16px rgba(0,0,0,0.4), 0 2px 4px rgba(0,0,0,0.2);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  font-size: 1rem;
  line-height: 1.6;
  max-width: 1400px;
  margin: 0 auto;
  padding: 3rem 2rem;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Header */
.page-header {
  margin-bottom: 2.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
}

.page-header h1 {
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  margin-bottom: 0.5rem;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem 1.25rem;
  font-size: 0.9rem;
  color: var(--text-tertiary);
}

.meta a {
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
}
.meta a:hover { text-decoration: underline; }

/* Collapsible sections */
.section { margin-bottom: 2.5rem; }

.section-heading {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  user-select: none;
  list-style: none;
  margin-bottom: 1rem;
}
.section-heading::-webkit-details-marker { display: none; }

.section-heading .chevron {
  width: 16px;
  height: 16px;
  color: var(--text-tertiary);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
details[open] > .section-heading .chevron {
  transform: rotate(90deg);
}

.section-title {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-tertiary);
}
.section-count {
  font-weight: 400;
  opacity: 0.7;
}

/* Requirements */
.requirements {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.req {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.875rem;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  user-select: none;
  transition: all 0.15s ease;
  box-shadow: var(--shadow-sm);
  color: var(--text-secondary);
  font-family: var(--font);
}
.req:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-md);
  background: var(--surface-hover);
}
.req .req-type {
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-tertiary);
  background: var(--bg);
  padding: 0.1rem 0.3rem;
  border-radius: 3px;
}
.req.active {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
}
.req.active:hover {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--accent);
  box-shadow: var(--shadow-md);
}
.req.active .req-type {
  background: var(--accent);
  color: white;
}

/* Items */
.items {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
  box-shadow: var(--shadow-sm);
  flex: 1 1 auto;
  min-width: 240px;
}
.item.item-text {
  flex-basis: 50%;
  min-width: 300px;
}

.item-label {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 0.125rem;
}

.item .note {
  font-size: 0.85rem;
  color: var(--text-tertiary);
  margin-bottom: 0.625rem;
}

.item-label + .choices,
.item-label + input,
.item-label + textarea { margin-top: 0.625rem; }
.item .note + .choices,
.item .note + input,
.item .note + textarea { margin-top: 0; }

.choices {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}

.choice {
  padding: 0.4rem 0.8rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  background: var(--surface);
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
  font-family: var(--font);
  transition: all 0.15s ease;
}
.choice:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}
.choice.selected {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
}

input[type="number"], input[type="text"], textarea {
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.9rem;
  font-family: var(--font);
  color: var(--text);
  background: var(--surface);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
input:focus, textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
textarea {
  resize: vertical;
  min-height: 56px;
}
input::placeholder, textarea::placeholder {
  color: var(--text-tertiary);
}

/* Options grid */
.options {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 1rem;
}

.option {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}
.option:hover {
  box-shadow: var(--shadow-md);
}

.option.blocked { opacity: 0.7; }
.option.eliminated { opacity: 0.5; }

details.option > summary { list-style: none; cursor: pointer; }
details.option > summary::-webkit-details-marker { display: none; }

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 0.375rem;
}
details.option:not([open]) .option-header { margin-bottom: 0; }

.option-title {
  font-weight: 700;
  font-size: 1.05rem;
  letter-spacing: -0.01em;
}

.option-status {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 0.1875rem 0.5rem;
  border-radius: 4px;
  flex-shrink: 0;
}
.option-status.possible { background: var(--success-bg); color: var(--success); border: 1px solid var(--success-border); }
.option-status.blocked { background: var(--blocked-bg); color: var(--blocked); border: 1px solid var(--blocked-border); }
.option-status.eliminated { background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger-border); }

.option-desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 1rem;
}

/* Requirements grid (commit-graph style) */
.req-grid {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 0.75rem;
}
.req-grid-cells {
  display: flex;
  gap: 3px;
}
.req-cell {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  background: var(--grid-empty);
  transition: background 0.2s ease;
  cursor: default;
  position: relative;
}
.req-cell.met { background: var(--grid-met); }
.req-cell.partial { background: var(--grid-partial); }
.req-cell.failed { background: var(--danger); }


.req-grid-label {
  font-size: 0.75rem;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* Details within options */
.failed-reqs {
  font-size: 0.85rem;
  color: var(--danger);
  font-weight: 500;
  margin-top: 0.5rem;
  padding: 0.375rem 0.5rem;
  background: var(--danger-bg);
  border-radius: var(--radius-sm);
}

.blocks-list, .effects-list {
  list-style: none;
  font-size: 0.9rem;
  margin-top: 0.625rem;
}
.blocks-list li, .effects-list li {
  padding: 0.25rem 0;
  line-height: 1.4;
}
.blocks-list li + li, .effects-list li + li {
  border-top: 1px solid var(--border);
  padding-top: 0.375rem;
  margin-top: 0.125rem;
}

.effect-category {
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 0.125rem 0.375rem;
  border-radius: 3px;
  margin-right: 0.25rem;
}

.block-reason {
  color: var(--blocked);
  font-weight: 500;
}

/* Pros/Cons */
.pros-cons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border);
}

.pros-cons-label {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 0.25rem;
}
.pros .pros-cons-label { color: var(--success); }
.cons .pros-cons-label { color: var(--danger); }

.pros ul, .cons ul {
  list-style: none;
  font-size: 0.9rem;
}
.pros li::before {
  content: "+";
  color: var(--success);
  font-weight: 700;
  margin-right: 0.375rem;
}
.cons li::before {
  content: "−";
  color: var(--danger);
  font-weight: 700;
  margin-right: 0.375rem;
}
.pros li, .cons li {
  padding: 0.125rem 0;
  color: var(--text-secondary);
}

/* Header layout */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}

/* Theme toggle */
.theme-toggle {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.375rem;
  cursor: pointer;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  transition: all 0.15s ease;
  box-shadow: var(--shadow-sm);
}
.theme-toggle:hover {
  border-color: var(--border-strong);
  box-shadow: var(--shadow-md);
  color: var(--text);
}
.theme-toggle svg {
  width: 18px;
  height: 18px;
}
.theme-toggle .icon-moon { display: none; }
[data-theme="dark"] .theme-toggle .icon-sun { display: none; }
[data-theme="dark"] .theme-toggle .icon-moon { display: block; }

/* Footer */
.page-footer {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
  text-align: center;
  font-size: 0.85rem;
  color: var(--text-tertiary);
}
.page-footer a {
  color: var(--text-secondary);
  text-decoration: none;
  font-weight: 500;
}
.page-footer a:hover {
  color: var(--accent);
  text-decoration: underline;
}

/* Responsive */
@media (max-width: 720px) {
  body { padding: 1.5rem 1rem; }
  .options { grid-template-columns: 1fr; }
  .pros-cons { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
  <header class="page-header">
    <div class="header-row">
      <h1>Cache Strategy Decision</h1>
      <button type="button" class="theme-toggle" id="theme-toggle" title="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
    <div class="meta">
      <span><a href="https://github.com/example/project/issues/42" target="_blank" rel="noopener">View Issue ↗</a></span>
      <span>2026-09-15</span>
      <span>Alice, Bob, Carol</span>
    </div>
  </header>

  <details class="section" open>
    <summary class="section-heading">
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Requirements <span class="section-count">(5)</span></span>
    </summary>
    <div class="requirements">
      <button type="button" class="req active" data-id="req-latency">
        P99 latency under 50ms
        <span class="req-type">hard</span>
      </button>
      <button type="button" class="req active" data-id="req-budget">
        Stay within $500/mo infrastructure budget
        <span class="req-type">hard</span>
      </button>
      <button type="button" class="req active" data-id="req-ha">
        99.9% availability SLA
        <span class="req-type">hard</span>
      </button>
      <button type="button" class="req active" data-id="req-observability">
        Supports distributed tracing
        <span class="req-type">soft</span>
      </button>
      <button type="button" class="req" data-id="req-team-skill">
        Team has operational experience
        <span class="req-type">soft</span>
      </button>
      
    </div>
  </details>

  <details class="section" open>
    <summary class="section-heading">
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Items <span class="section-count">(5)</span></span>
    </summary>
    <div class="items">
      <div class="item">
        <div class="item-label">Expected peak traffic</div>
        
        <div class="choices">
          <button type="button" class="choice" data-item="q-traffic" data-answer="low">Under 1k RPS</button>
          <button type="button" class="choice" data-item="q-traffic" data-answer="mid">1k–10k RPS</button>
          <button type="button" class="choice" data-item="q-traffic" data-answer="high">Over 10k RPS</button>
          
        </div>
        
      </div>
      <div class="item">
        <div class="item-label">Multi-region deployment</div>
        
        <div class="choices">
          <button type="button" class="choice" data-item="q-region" data-answer="yes">Yes, multi-region</button>
          <button type="button" class="choice" data-item="q-region" data-answer="no">Single region</button>
          
        </div>
        
      </div>
      <div class="item">
        <div class="item-label">Data sensitivity level</div>
        <div class="note">Affects where data can be cached and for how long</div>
        <div class="choices">
          <button type="button" class="choice" data-item="q-data-sensitivity" data-answer="public">Public data</button>
          <button type="button" class="choice" data-item="q-data-sensitivity" data-answer="internal">Internal only</button>
          <button type="button" class="choice" data-item="q-data-sensitivity" data-answer="pii">Contains PII</button>
          
        </div>
        
      </div>
      <div class="item">
        <div class="item-label">Cache TTL</div>
        
        <input type="number" class="item-input" data-item="q-ttl"
          min="1" max="3600"
          
          placeholder="seconds">
        
      </div>
      <div class="item item-text">
        <div class="item-label">Additional context or constraints</div>
        
        <textarea class="item-input" data-item="q-notes" placeholder="Enter text..."></textarea>
        
      </div>
      
    </div>
  </details>

  <details class="section" open>
    <summary class="section-heading">
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="section-title">Design Options <span class="section-count">(4)</span></span>
    </summary>
    <div class="options">
      <details id="option-opt-redis" class="option possible" open>
        <summary class="option-header">
          <span class="option-title">Redis Cluster</span>
          <span class="option-status possible">possible</span>
        </summary>
        <div class="option-desc">Managed Redis with read replicas and automatic failover</div>

        <div class="req-grid" data-option="opt-redis">
          <div class="req-grid-cells">
            <div class="req-cell met" title="P99 latency under 50ms (hard) — met" data-req="req-latency"></div>
            <div class="req-cell partial" title="Stay within $500/mo infrastructure budget (hard) — partial" data-req="req-budget"></div>
            <div class="req-cell met" title="99.9% availability SLA (hard) — met" data-req="req-ha"></div>
            <div class="req-cell met" title="Supports distributed tracing (soft) — met" data-req="req-observability"></div>
            <div class="req-cell met" title="Team has operational experience (soft) — met" data-req="req-team-skill"></div>
            
          </div>
          <span class="req-grid-label">2/3 hard · 1/2 soft</span>
        </div>

        <div class="failed-reqs" style="display:none">
          
        </div>

        <ul class="blocks-list" style="display:none">
          
        </ul>

        <div class="pros-cons">
          <div class="pros">
            <div class="pros-cons-label">Pros</div>
            <ul><li>Battle-tested, rich data structures</li><li>Strong community and tooling</li><li>Built-in pub/sub for cache invalidation</li></ul>
          </div>
          
          <div class="cons">
            <div class="pros-cons-label">Cons</div>
            <ul><li>Operational overhead for cluster management</li><li>Memory-bound, expensive at scale</li></ul>
          </div>
          
        </div>
        

        <ul class="effects-list" style="display:none">
          
        </ul>
      </details>
      <details id="option-opt-cdn" class="option possible" open>
        <summary class="option-header">
          <span class="option-title">CDN Edge Cache</span>
          <span class="option-status possible">possible</span>
        </summary>
        <div class="option-desc">Cache at the edge using a CDN provider like CloudFront or Fastly</div>

        <div class="req-grid" data-option="opt-cdn">
          <div class="req-grid-cells">
            <div class="req-cell met" title="P99 latency under 50ms (hard) — met" data-req="req-latency"></div>
            <div class="req-cell met" title="Stay within $500/mo infrastructure budget (hard) — met" data-req="req-budget"></div>
            <div class="req-cell met" title="99.9% availability SLA (hard) — met" data-req="req-ha"></div>
            <div class="req-cell " title="Supports distributed tracing (soft) — " data-req="req-observability"></div>
            <div class="req-cell " title="Team has operational experience (soft) — " data-req="req-team-skill"></div>
            
          </div>
          <span class="req-grid-label">3/3 hard · 0/2 soft</span>
        </div>

        <div class="failed-reqs" style="display:none">
          
        </div>

        <ul class="blocks-list" style="display:none">
          
        </ul>

        <div class="pros-cons">
          <div class="pros">
            <div class="pros-cons-label">Pros</div>
            <ul><li>Zero operational overhead</li><li>Globally distributed by default</li><li>Cost-effective at any scale</li></ul>
          </div>
          
          <div class="cons">
            <div class="pros-cons-label">Cons</div>
            <ul><li>Limited invalidation control (TTL-based)</li><li>No tracing or observability built in</li><li>Team has no CDN operational experience</li></ul>
          </div>
          
        </div>
        

        <ul class="effects-list" style="display:none">
          
        </ul>
      </details>
      <details id="option-opt-memcached" class="option eliminated" open>
        <summary class="option-header">
          <span class="option-title">Memcached</span>
          <span class="option-status eliminated">eliminated</span>
        </summary>
        <div class="option-desc">Simple in-memory key-value store, optimized for high-throughput reads</div>

        <div class="req-grid" data-option="opt-memcached">
          <div class="req-grid-cells">
            <div class="req-cell met" title="P99 latency under 50ms (hard) — met" data-req="req-latency"></div>
            <div class="req-cell met" title="Stay within $500/mo infrastructure budget (hard) — met" data-req="req-budget"></div>
            <div class="req-cell " title="99.9% availability SLA (hard) — " data-req="req-ha"></div>
            <div class="req-cell " title="Supports distributed tracing (soft) — " data-req="req-observability"></div>
            <div class="req-cell met" title="Team has operational experience (soft) — met" data-req="req-team-skill"></div>
            
          </div>
          <span class="req-grid-label">2/3 hard · 1/2 soft</span>
        </div>

        <div class="failed-reqs" >
          Failed: 99.9% availability SLA
        </div>

        <ul class="blocks-list" style="display:none">
          
        </ul>

        <div class="pros-cons">
          <div class="pros">
            <div class="pros-cons-label">Pros</div>
            <ul><li>Extremely fast, simple protocol</li><li>Low memory overhead per key</li><li>Team already runs Memcached in production</li></ul>
          </div>
          
          <div class="cons">
            <div class="pros-cons-label">Cons</div>
            <ul><li>No persistence or replication</li><li>No complex data structures</li><li>Single point of failure without custom HA wrapper</li></ul>
          </div>
          
        </div>
        

        <ul class="effects-list" style="display:none">
          
        </ul>
      </details>
      <details id="option-opt-app-cache" class="option possible" open>
        <summary class="option-header">
          <span class="option-title">Application-Level Cache</span>
          <span class="option-status possible">possible</span>
        </summary>
        <div class="option-desc">In-process cache using an LRU library (e.g., Ristretto, BigCache)</div>

        <div class="req-grid" data-option="opt-app-cache">
          <div class="req-grid-cells">
            <div class="req-cell met" title="P99 latency under 50ms (hard) — met" data-req="req-latency"></div>
            <div class="req-cell met" title="Stay within $500/mo infrastructure budget (hard) — met" data-req="req-budget"></div>
            <div class="req-cell partial" title="99.9% availability SLA (hard) — partial" data-req="req-ha"></div>
            <div class="req-cell met" title="Supports distributed tracing (soft) — met" data-req="req-observability"></div>
            <div class="req-cell met" title="Team has operational experience (soft) — met" data-req="req-team-skill"></div>
            
          </div>
          <span class="req-grid-label">2/3 hard · 2/2 soft</span>
        </div>

        <div class="failed-reqs" style="display:none">
          
        </div>

        <ul class="blocks-list" style="display:none">
          
        </ul>

        <div class="pros-cons">
          <div class="pros">
            <div class="pros-cons-label">Pros</div>
            <ul><li>Zero infrastructure cost</li><li>Sub-microsecond latency</li><li>No network calls</li></ul>
          </div>
          
          <div class="cons">
            <div class="pros-cons-label">Cons</div>
            <ul><li>Not shared across instances</li><li>Cache lost on deploy/restart</li><li>Memory pressure on application pods</li></ul>
          </div>
          
        </div>
        

        <ul class="effects-list" style="display:none">
          
        </ul>
      </details>
      
    </div>
  </details>

  <footer class="page-footer">
